# Rate limiter configuration. Real environment variables override this file.
# Safe defaults only: this file is committed so `docker compose up` works out of the box.

# HTTP server port inside the container / on the host when run locally.
SERVER_PORT=8080

# Persistence strategy: redis | memory
STORE_DRIVER=redis

# Maximum requests per second for a single IP (applies when no API_KEY header is sent).
RATE_LIMIT_IP=10

# Maximum requests per second for a token that has no specific entry in TOKEN_LIMITS.
RATE_LIMIT_TOKEN_DEFAULT=100

# Per-token limits (req/s) as token:limit pairs separated by commas.
# A token's limit takes precedence over the IP limit.
TOKEN_LIMITS=abc123:100,vip:500,tiny:2

# How long an IP/token stays blocked after exceeding its limit (Go duration: 30s, 5m, 1h).
BLOCK_DURATION=5m

# Redis connection (REDIS_ADDR is overridden to redis:6379 by docker-compose).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# true: let requests through when the limiter store fails; false: answer 503.
FAIL_OPEN=true

# true: take the client IP from X-Forwarded-For (only behind a trusted proxy).
TRUST_PROXY_HEADERS=false
